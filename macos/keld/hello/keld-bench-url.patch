+//! Benchmark-only startup stage tracing for the macOS hello adapter.
+//!
+//! This module is compiled only by the public benchmark recipe patch. The
+//! normal Keld source tree does not contain it and production launches remain
+//! unaffected. When `KELD_BENCH_STARTUP_TRACE` names a harness-owned private
+//! path, the adapter writes one nonce-bound record after `WebView` construction.
+
+use std::env;
+use std::fs::OpenOptions;
+use std::io::Write;
+use std::path::PathBuf;
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+use crate::error::WvError;
+
+static STARTUP_TRACE: OnceLock<Mutex<Option<StartupTrace>>> = OnceLock::new();
+
+/// A monotonic startup stage emitted by the benchmark-only adapter.
+#[derive(Clone, Copy)]
+pub(crate) enum Stage {
+    /// The public hello entry point began running.
+    WvRunEntered,
+    /// Tao created the macOS event loop.
+    EventLoopCreated,
+    /// Tao/AppKit created the native window.
+    WindowBuilt,
+    /// Wry/WebKit created the webview.
+    WebviewBuilt,
+}
+
+impl Stage {
+    const fn index(self) -> usize {
+        match self {
+            Self::WvRunEntered => 0,
+            Self::EventLoopCreated => 1,
+            Self::WindowBuilt => 2,
+            Self::WebviewBuilt => 3,
+        }
+    }
+}
+
+struct StartupTrace {
+    path: PathBuf,
+    token: String,
+    started: Instant,
+    stages: [Option<u64>; 4],
+}
+
+impl StartupTrace {
+    fn new(path: PathBuf, token: String) -> Self {
+        Self {
+            path,
+            token,
+            started: Instant::now(),
+            stages: [None; 4],
+        }
+    }
+
+    fn record_elapsed(&mut self, stage: Stage, elapsed_ns: u64) -> Result<(), WvError> {
+        let index = stage.index();
+        if self.stages[index].is_some() {
+            return Err(WvError::EventLoop(String::from(
+                "KELD-BENCH: startup stage was recorded twice",
+            )));
+        }
+        if index > 0 {
+            let previous = self.stages[index - 1].ok_or_else(|| {
+                WvError::EventLoop(String::from(
+                    "KELD-BENCH: startup stage order is incomplete",
+                ))
+            })?;
+            if elapsed_ns <= previous {
+                return Err(WvError::EventLoop(String::from(
+                    "KELD-BENCH: startup stages did not advance monotonically",
+                )));
+            }
+        }
+        self.stages[index] = Some(elapsed_ns);
+        Ok(())
+    }
+
+    fn record(&mut self, stage: Stage) -> Result<(), WvError> {
+        let elapsed = if stage.index() == 0 {
+            0
+        } else {
+            u64::try_from(self.started.elapsed().as_nanos()).map_err(|_| {
+                WvError::EventLoop(String::from("KELD-BENCH: startup duration overflowed u64"))
+            })?
+        };
+        self.record_elapsed(stage, elapsed)
+    }
+
+    fn format_record(&self) -> Result<String, WvError> {
+        let [
+            Some(wv_run_entered),
+            Some(event_loop_created),
+            Some(window_built),
+            Some(webview_built),
+        ] = self.stages
+        else {
+            return Err(WvError::EventLoop(String::from(
+                "KELD-BENCH: startup trace is incomplete",
+            )));
+        };
+        Ok(format!(
+            "version=1\ntoken={}\nwv_run_entered_ns={wv_run_entered}\n\
+             event_loop_created_ns={event_loop_created}\nwindow_built_ns={window_built}\n\
+             webview_built_ns={webview_built}\n",
+            self.token
+        ))
+    }
+
+    fn write(&self) -> Result<(), WvError> {
+        let text = self.format_record()?;
+        let mut file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&self.path)
+            .map_err(|error| {
+                WvError::EventLoop(format!(
+                    "KELD-BENCH: could not create startup trace: {error}"
+                ))
+            })?;
+        file.write_all(text.as_bytes()).map_err(|error| {
+            WvError::EventLoop(format!(
+                "KELD-BENCH: could not write startup trace: {error}"
+            ))
+        })
+    }
+}
+
+/// Reads the opt-in adapter configuration before any stage is recorded.
+///
+/// # Errors
+///
+/// Returns an explicit benchmark-adapter error if only one required variable
+/// is supplied or the process tries to initialize tracing more than once.
+pub(crate) fn initialize() -> Result<(), WvError> {
+    if STARTUP_TRACE.get().is_some() {
+        return Ok(());
+    }
+    let trace = match (
+        env::var("KELD_BENCH_STARTUP_TRACE"),
+        env::var("KELD_BENCH_TOKEN"),
+    ) {
+        (Err(env::VarError::NotPresent), _) => None,
+        (Ok(path), Ok(token)) if !path.is_empty() && !token.is_empty() => {
+            Some(StartupTrace::new(PathBuf::from(path), token))
+        }
+        _ => {
+            return Err(WvError::EventLoop(String::from(
+                "KELD-BENCH: startup tracing requires both KELD_BENCH_STARTUP_TRACE and KELD_BENCH_TOKEN",
+            )));
+        }
+    };
+    STARTUP_TRACE.set(Mutex::new(trace)).map_err(|_| {
+        WvError::EventLoop(String::from(
+            "KELD-BENCH: startup tracing initialized more than once",
+        ))
+    })
+}
+
+/// Records one startup stage when benchmark tracing is enabled.
+///
+/// # Errors
+///
+/// Returns an explicit benchmark-adapter error for a repeated, missing, or
+/// non-monotonic stage. The normal launch path does no work when tracing is
+/// disabled.
+pub(crate) fn record(stage: Stage) -> Result<(), WvError> {
+    let Some(lock) = STARTUP_TRACE.get() else {
+        return Ok(());
+    };
+    let mut guard = lock.lock().map_err(|_| {
+        WvError::EventLoop(String::from("KELD-BENCH: startup trace lock was poisoned"))
+    })?;
+    let Some(trace) = guard.as_mut() else {
+        return Ok(());
+    };
+    trace.record(stage)
+}
+
+/// Writes the completed trace before the first page can signal the harness.
+///
+/// # Errors
+///
+/// Returns an explicit benchmark-adapter error unless each stage was recorded
+/// exactly once and the private destination can be created without replacing
+/// an existing file.
+pub(crate) fn flush() -> Result<(), WvError> {
+    let Some(lock) = STARTUP_TRACE.get() else {
+        return Ok(());
+    };
+    let state = lock.lock().map_err(|_| {
+        WvError::EventLoop(String::from("KELD-BENCH: startup trace lock was poisoned"))
+    })?;
+    let Some(trace) = state.as_ref() else {
+        return Ok(());
+    };
+    trace.write()
+}
+
+#[cfg(test)]
+mod tests {
+    use std::fs;
+    use std::path::PathBuf;
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    use super::{Stage, StartupTrace};
+
+    fn unique_trace_path() -> PathBuf {
+        let nanos = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .expect("system clock is after UNIX_EPOCH")
+            .as_nanos();
+        std::env::temp_dir().join(format!(
+            "keld-startup-trace-ac1-{}-{nanos}.txt",
+            std::process::id()
+        ))
+    }
+
+    fn complete_trace(path: PathBuf, token: &str) -> StartupTrace {
+        let mut trace = StartupTrace::new(path, String::from(token));
+        trace
+            .record_elapsed(Stage::WvRunEntered, 0)
+            .expect("wv_run_entered");
+        trace
+            .record_elapsed(Stage::EventLoopCreated, 46_906_000)
+            .expect("event_loop_created");
+        trace
+            .record_elapsed(Stage::WindowBuilt, 95_141_000)
+            .expect("window_built");
+        trace
+            .record_elapsed(Stage::WebviewBuilt, 149_031_000)
+            .expect("webview_built");
+        trace
+    }
+
+    #[test]
+    fn valid_four_stages_format_one_nonce_bound_record() {
+        let trace = complete_trace(unique_trace_path(), "launch-nonce-ac1");
+        let record = trace.format_record().expect("complete trace");
+        assert_eq!(
+            record,
+            "version=1\n\
+             token=launch-nonce-ac1\n\
+             wv_run_entered_ns=0\n\
+             event_loop_created_ns=46906000\n\
+             window_built_ns=95141000\n\
+             webview_built_ns=149031000\n"
+        );
+    }
+
+    #[test]
+    fn valid_four_stages_write_exactly_one_file() {
+        let path = unique_trace_path();
+        let _ = fs::remove_file(&path);
+        let trace = complete_trace(path.clone(), "launch-nonce-ac1");
+        trace.write().expect("create the arm's trace");
+        let written = fs::read_to_string(&path).expect("read the arm's trace");
+        assert_eq!(written, trace.format_record().expect("complete trace"));
+        assert!(
+            fs::metadata(&path).expect("trace metadata").is_file(),
+            "the arm must emit a regular trace file"
+        );
+        fs::remove_file(&path).expect("cleanup");
+    }
+
+    #[test]
+    fn incomplete_stages_cannot_publish_a_record() {
+        let mut trace = StartupTrace::new(unique_trace_path(), String::from("launch-nonce-ac1"));
+        trace
+            .record_elapsed(Stage::WvRunEntered, 0)
+            .expect("wv_run_entered");
+        trace
+            .record_elapsed(Stage::EventLoopCreated, 1)
+            .expect("event_loop_created");
+        trace
+            .record_elapsed(Stage::WindowBuilt, 2)
+            .expect("window_built");
+        let err = trace
+            .format_record()
+            .expect_err("webview_built is required");
+        assert!(
+            err.to_string()
+                .contains("KELD-BENCH: startup trace is incomplete"),
+            "incomplete trace must fail closed, got {err}"
+        );
+    }
+}
